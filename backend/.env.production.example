# Plantilla de referencia para producción NO es un .env real, no tiene
# valores reales. Copiar a `.env.production` (ya está en .gitignore) y
# completar cada __REEMPLAZAR__ con un gestor de secretos (nunca commitear
# el archivo con valores reales).

APP_NAME="Biblioteca UMAG"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=__REEMPLAZAR__
APP_TIMEZONE=America/Punta_Arenas
APP_LOCALE=es

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=__REEMPLAZAR__
DB_PORT=3306
DB_DATABASE=__REEMPLAZAR__
DB_USERNAME=__REEMPLAZAR__
DB_PASSWORD=__REEMPLAZAR__
# La base tiene que estar creada con CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci
# (las búsquedas sin tildes dependen de eso). Si el servidor MySQL de Informática
# exige TLS, apuntar acá al certificado de su CA (ruta dentro del contenedor).
DB_COLLATION=utf8mb4_unicode_ci
MYSQL_ATTR_SSL_CA=

FRONTEND_URL=__REEMPLAZAR__
SANCTUM_STATEFUL_DOMAINS=__REEMPLAZAR__
SESSION_DOMAIN=__REEMPLAZAR__
SANCTUM_TOKEN_EXPIRATION=480

CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file

# Notificaciones (reserva lista para retirar, multa generada). En 'log' quedan
# escritas en el log del contenedor en vez de enviarse; cambiar a 'smtp' y
# completar el resto cuando Informática entregue el servidor de correo.
MAIL_MAILER=log
MAIL_HOST=__REEMPLAZAR__
MAIL_PORT=587
MAIL_USERNAME=__REEMPLAZAR__
MAIL_PASSWORD=__REEMPLAZAR__
MAIL_FROM_ADDRESS=biblioteca@umag.cl
MAIL_FROM_NAME="Biblioteca UMAG"
# Segundos de espera al servidor de correo; si no responde, el aviso queda en el log.
MAIL_TIMEOUT=10

# Login con Google (LoginV2View.vue) — código ya implementado, inactivo sin
# esto. Ver docs/login-externo-pendientes.md para cómo generarlas.
GOOGLE_CLIENT_ID=__REEMPLAZAR__
GOOGLE_CLIENT_SECRET=__REEMPLAZAR__
GOOGLE_REDIRECT_URI=__REEMPLAZAR__
# Dominios de Google Workspace aceptados, separados por coma (ej. umag.cl,alumnos.umag.cl).
GOOGLE_DOMINIOS=__REEMPLAZAR__

# Login LDAP institucional (LoginV2View.vue) — código ya implementado,
# inactivo sin esto. Ver docs/login-externo-pendientes.md para el detalle de
# cada variable (qué le corresponde pedirle a informática de la UMAG).
LDAP_HOST=__REEMPLAZAR__
LDAP_PORT=389
LDAP_BASE_DN=__REEMPLAZAR__
LDAP_BIND_USERNAME=__REEMPLAZAR__
LDAP_BIND_PASSWORD=__REEMPLAZAR__
LDAP_USER_ATTRIBUTE=__REEMPLAZAR__
LDAP_EMAIL_ATTRIBUTE=__REEMPLAZAR__
LDAP_TLS=false

# Correos simulados del login v2: solo para desarrollo. Apagado (y el servidor lo
# rechaza igual con APP_ENV=production).
LOGIN_V2_CORREOS_SIMULADOS=false
