APP_NAME="Biblioteca UMAG"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Punta_Arenas

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=biblioteca
DB_USERNAME=biblioteca
DB_PASSWORD=biblioteca

FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173
SESSION_DOMAIN=localhost
# Minutos hasta que un token de acceso (staff o usuario) se considera vencido.
SANCTUM_TOKEN_EXPIRATION=480

CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file

# Notificaciones (reserva lista para retirar, multa generada) ya están implementadas
# (App\Notifications\*) pero no hay host de correo real todavía. Con 'log', Laravel
# escribe el correo completo en storage/logs/laravel.log en vez de intentar enviarlo —
# no falla, no requiere red. Cuando haya un SMTP real, cambiar a 'smtp' + MAIL_HOST/
# MAIL_PORT/MAIL_USERNAME/MAIL_PASSWORD/MAIL_FROM_ADDRESS acá, sin tocar código.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=biblioteca@umag.cl
MAIL_FROM_NAME="Biblioteca UMAG"

# Login con Google (LoginV2View.vue) — GoogleAuthController ya está implementado,
# pero sin GOOGLE_CLIENT_ID configurado el botón responde "no configurado" en vez
# de intentar redirigir a Google. Se generan en Google Cloud Console > Credentials
# > OAuth Client ID (tipo "Web application"), con GOOGLE_REDIRECT_URI como el
# "Authorized redirect URI" registrado ahí.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Login LDAP institucional (LoginV2View.vue) — LdapAuthController ya está
# implementado (patrón "search + bind": conecta con la cuenta de servicio,
# busca al usuario por LDAP_USER_ATTRIBUTE, y recién ahí intenta el bind con la
# contraseña que ingresó, sin asumir un formato de DN fijo). Sin LDAP_HOST
# configurado, el botón responde "no configurado" en vez de intentar conectar.
# LDAP_USER_ATTRIBUTE/LDAP_EMAIL_ATTRIBUTE son ajustables porque no se conoce
# todavía el esquema real del directorio de la UMAG (Active Directory usa
# típicamente sAMAccountName, OpenLDAP usa uid).
LDAP_HOST=
LDAP_PORT=389
LDAP_BASE_DN=
LDAP_BIND_USERNAME=
LDAP_BIND_PASSWORD=
LDAP_USER_ATTRIBUTE=mail
LDAP_EMAIL_ATTRIBUTE=mail
LDAP_TLS=false
